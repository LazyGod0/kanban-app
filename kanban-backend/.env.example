# PostgreSQL settings
DB_NAME=kanban-app-db
DB_USER=kanban-app
DB_PASSWORD=change-me
DB_HOST=db

# PostgreSQL container settings. Keep these values aligned with DB_NAME,
# DB_USER, and DB_PASSWORD when using Docker Compose.
POSTGRES_DB=kanban-app-db
POSTGRES_USER=kanban-app
POSTGRES_PASSWORD=change-me

# Replace with a random value of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-chars

# Application URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
